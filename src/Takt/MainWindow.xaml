<Window x:Class="Takt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource App.Title}"
        Width="520" Height="740"
        MinWidth="380" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="True" CornerRadius="8" />
    </shell:WindowChrome.WindowChrome>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="42" Margin="12,0,148,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                     Fill="{Binding ActivityHex, Converter={StaticResource HexToBrush}}"
                     ToolTip="{Binding DeadlineText}" />
            <TextBlock Grid.Column="1" Text="{DynamicResource App.Title}" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource CaptionButton}" Command="{Binding ToggleCompactCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="{DynamicResource Compact.Title}" Margin="0,0,8,0"
                        AutomationProperties.Name="{DynamicResource Compact.Title}">
                    <Path Data="{StaticResource Icon.Compact}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2" Width="14" Height="14" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Command="{Binding PanicCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="{Binding PanicHotkeyText}" Margin="0,0,8,0"
                        AutomationProperties.Name="{DynamicResource Action.Panic}">
                    <Path Data="{StaticResource Icon.Stop}" Fill="{DynamicResource TextBrush}" Width="10" Height="10" Stretch="Fill" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Command="{Binding OpenSettingsCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="{DynamicResource Action.Settings}"
                        AutomationProperties.Name="{DynamicResource Action.Settings}">
                    <Path Data="{StaticResource Icon.Gear}" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>
        <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <ComboBox DockPanel.Dock="Right" Width="180" VerticalAlignment="Center"
                      ItemsSource="{Binding Settings.Profiles}" DisplayMemberPath="Name"
                      SelectedItem="{Binding ActiveProfile}"
                      ToolTip="{DynamicResource Tip.Profile}" />
            <TextBlock Text="{DynamicResource App.Subtitle}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="8"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding ShowFirstRunHint, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28"
                            Margin="8,0,0,0" Command="{Binding DismissFirstRunCommand}"
                            AutomationProperties.Name="{DynamicResource FirstRun.Dismiss}">
                        <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Fill" />
                    </Button>
                    <TextBlock Text="{Binding FirstRunHint}" Style="{StaticResource HintText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintText}" TextWrapping="Wrap" />
            <Button Style="{StaticResource GhostButton}" Command="{Binding TogglePauseCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{Binding PauseLabel}" ToolTip="{DynamicResource Tip.Pause}" />
            <TextBlock Text="{Binding DeadlineText}" Style="{StaticResource HintText}" Margin="0,4,0,0" ToolTip="{DynamicResource Tip.StopMinutes}" />
            <TextBlock Text="{Binding RemainderText}" Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap" ToolTip="{DynamicResource Tip.Remain}" />
            <TextBlock Text="{Binding WeekSummary}" Style="{StaticResource HintText}" Margin="0,8,0,6"
                       Visibility="{Binding HideWeek, Converter={StaticResource BoolVis}}" />
            <ItemsControl ItemsSource="{Binding WeekCells}" Margin="0,4,0,0"
                          Visibility="{Binding ShowWeek, Converter={StaticResource BoolVis}}"
                          ToolTip="{DynamicResource Stats.WeekHint}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,6" Margin="2,0" ToolTip="{Binding Detail}">
                            <StackPanel>
                                <TextBlock Text="{Binding Day}" Style="{StaticResource HintText}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Clicks}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding SafetyHint}" Style="{StaticResource HintText}" Margin="0,8,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="CardHost" MinHeight="280">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="220" />
                </Grid.ColumnDefinitions>

                <Border x:Name="JigglerCard" Grid.Column="0" Padding="14" CornerRadius="10" ClipToBounds="True"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="4" Width="3" HorizontalAlignment="Left" Margin="-14,-14,0,-14" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Jiggler.Status}" Value="Running">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Jiggler.Status}" Value="Paused">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Card.Jiggler}" Style="{StaticResource TitleText}" Margin="0,0,52,0" />
                            <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          IsChecked="{Binding JigglerOn, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Tip.Jiggler}"
                                          AutomationProperties.Name="{DynamicResource Card.Jiggler}" />
                        </Grid>
                        <Border Grid.Row="1" HorizontalAlignment="Left" CornerRadius="8" Padding="8,2" Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Jiggler.Status}" Value="Running">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Jiggler.Status}" Value="Paused">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding JigglerStatusText}" FontSize="11" FontFamily="Segoe UI">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Jiggler.Status}" Value="Running">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Jiggler.Status}" Value="Paused">
                                                <Setter Property="Foreground" Value="#1B1D22" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{DynamicResource Label.Mode}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding JigglerModes}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Settings.Jiggler.Mode}"
                                      Margin="0,0,0,10" />
                            <TextBlock Text="{DynamicResource Label.Interval}" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.Jiggler.IntervalMs, Converter={StaticResource MsToSec}, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Label.Seconds}" Style="{StaticResource HintText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding JigglePaces}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Command="{Binding DataContext.SetJigglePaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Value}" ToolTip="{DynamicResource Tip.JInterval}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource HexEquals}">
                                                                    <Binding Path="DataContext.Settings.Jiggler.IntervalMs" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    <Binding Path="Value" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{DynamicResource Card.Radius}" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.Jiggler.RadiusPx, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Column="1" Text="px" Style="{StaticResource HintText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding PickRadiusCommand}"
                                    HorizontalAlignment="Stretch" Padding="10,8">
                                <TextBlock Text="{DynamicResource Jiggler.PickRadius}" TextWrapping="NoWrap" TextAlignment="Center" />
                            </Button>
                            <CheckBox IsChecked="{Binding PresenceOn}" Margin="0,10,0,0" ToolTip="{DynamicResource Tip.Presence}">
                                <TextBlock Text="{DynamicResource Presence.Toggle}" TextWrapping="NoWrap" />
                            </CheckBox>
                            <TextBlock Text="{Binding PresenceStatusText}" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Style="{StaticResource HintText}" Margin="0,12,0,0">
                            <Run Text="{DynamicResource Label.Hotkey}" />
                            <Run Text=" " />
                            <Run Text="{Binding JigglerHotkeyText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <Border x:Name="ClickerCard" Grid.Column="2" Padding="14" CornerRadius="10" ClipToBounds="True"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="4" Width="3" HorizontalAlignment="Left" Margin="-14,-14,0,-14" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Clicker.Status}" Value="Running">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Clicker.Status}" Value="Paused">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Card.Clicker}" Style="{StaticResource TitleText}" Margin="0,0,52,0" />
                            <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          IsChecked="{Binding ClickerOn, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Tip.Clicker}"
                                          AutomationProperties.Name="{DynamicResource Card.Clicker}" />
                        </Grid>
                        <Border Grid.Row="1" HorizontalAlignment="Left" CornerRadius="8" Padding="8,2" Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Clicker.Status}" Value="Running">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Clicker.Status}" Value="Paused">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ClickerStatusText}" FontSize="11" FontFamily="Segoe UI">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Clicker.Status}" Value="Running">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Clicker.Status}" Value="Paused">
                                                <Setter Property="Foreground" Value="#1B1D22" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="{DynamicResource Label.Interval}" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Settings.Clicker.IntervalMs, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Label.Milliseconds}" Style="{StaticResource HintText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ClickPaces}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Command="{Binding DataContext.SetClickPaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Value}" ToolTip="{DynamicResource Tip.Interval}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource HexEquals}">
                                                                    <Binding Path="DataContext.Settings.Clicker.IntervalMs" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    <Binding Path="Value" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ClickSummary}" Style="{StaticResource HintText}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding TestClickCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" Content="{DynamicResource Clicker.Test}" ToolTip="{DynamicResource Tip.TestClick}" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding PickPositionCommand}"
                                    HorizontalAlignment="Stretch" Padding="10,8">
                                <TextBlock Text="{DynamicResource Clicker.Pick}" TextWrapping="NoWrap" TextAlignment="Center" />
                            </Button>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource Clicker.Progress}" Style="{StaticResource HintText}" />
                                <TextBlock Text="{Binding ClickerProgress}" Style="{StaticResource HintText}" Margin="6,0,0,0" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,4" Style="{StaticResource HintText}" Text="{Binding MacroSummary}" TextWrapping="NoWrap" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleRecordCommand}" Margin="0,0,8,0" Padding="8,6">
                                    <TextBlock Text="{Binding RecordLabel}" TextWrapping="NoWrap" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding TogglePlayCommand}" Padding="8,6">
                                    <TextBlock Text="{Binding PlayLabel}" TextWrapping="NoWrap" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Style="{StaticResource HintText}" Margin="0,12,0,0">
                            <Run Text="{DynamicResource Label.Hotkey}" />
                            <Run Text=" " />
                            <Run Text="{Binding ClickerHotkeyText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <Border x:Name="TyperCard" Grid.Row="2" Grid.ColumnSpan="3" Padding="14" CornerRadius="10" ClipToBounds="True"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="-14,-14,0,-14" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Typer.Status}" Value="Running">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Typer.Status}" Value="Paused">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Card.Typer}" Style="{StaticResource TitleText}" />
                                <ToggleButton Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right"
                                              IsChecked="{Binding TyperOn, Mode=TwoWay}"
                                              ToolTip="{DynamicResource Tip.Typer}"
                                              AutomationProperties.Name="{DynamicResource Card.Typer}" />
                            </Grid>
                            <TextBox Text="{Binding Settings.Typer.Text, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top" />
                            <Button Style="{StaticResource GhostButton}" Command="{Binding TestTypeCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{DynamicResource Typer.Test}" ToolTip="{DynamicResource Tip.TestType}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border HorizontalAlignment="Left" CornerRadius="8" Padding="8,2" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Typer.Status}" Value="Running">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TyperStatusText}" FontSize="11" FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}" />
                            </Border>
                            <TextBlock Text="{DynamicResource Typer.Speed}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Settings.Typer.CharactersPerMinute, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding TyperPaces}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Command="{Binding DataContext.SetTyperPaceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Value}" ToolTip="{DynamicResource Tip.Cpm}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource HexEquals}">
                                                                    <Binding Path="DataContext.Settings.Typer.CharactersPerMinute" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    <Binding Path="Value" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding TyperWpm}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                            <ComboBox ItemsSource="{Binding Settings.Typer.Snippets}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedSnippet}" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource HintText}">
                                <Run Text="{DynamicResource Label.Hotkey}" />
                                <Run Text=" " />
                                <Run Text="{Binding TyperHotkeyText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding TyperProgress}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
        </DockPanel>
    </DockPanel>
</Window>
