<Window x:Class="Takt.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}"
        Width="960" Height="720"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource Tip.Search}" />
            <ListBox ItemsSource="{Binding Navigation}" SelectedValuePath="Id" SelectedValue="{Binding SelectedSection}"
                     DisplayMemberPath="Title" BorderThickness="0" Background="Transparent" ToolTip="{DynamicResource Tip.Search}" />
        </DockPanel>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,8,12">
                <StackPanel x:Name="SectionGeneral" Visibility="{Binding ShowGeneral, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.General}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenWizardCommand}" HorizontalAlignment="Left" Margin="0,0,0,12" Content="{DynamicResource Wizard.Reopen}" ToolTip="{DynamicResource Tip.Wizard}" />
                    <TextBlock Text="{DynamicResource Appearance.Theme}" Style="{StaticResource FieldLabel}" />
                    <DockPanel x:Name="SetTheme" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Theme}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="theme" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Appearance.Theme}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Appearance.Language}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Language}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="language" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Appearance.Language}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Appearance.Accent}" Style="{StaticResource FieldLabel}" />
                    <ItemsControl ItemsSource="{Binding AccentPresets}" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Accent}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Width="32" Height="32" Margin="0,0,8,0" Padding="0"
                                        Style="{StaticResource IconButton}" AutomationProperties.Name="{Binding}">
                                    <Border Width="28" Height="28" CornerRadius="14" Padding="3" BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource HexEquals}">
                                                                <Binding />
                                                                <Binding Path="DataContext.Settings.Appearance.AccentHex" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border CornerRadius="10" Background="{Binding Converter={StaticResource HexToBrush}}" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel x:Name="SetAccent" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Accent}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="accent" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" />
                        <TextBox Text="{Binding Settings.Appearance.AccentHex, UpdateSourceTrigger=LostFocus}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AccentValid}" Value="False">
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Autostart}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="autostart" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.General.StartWithWindows}" Content="{DynamicResource General.Autostart}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.StartMin}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="min" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.General.StartMinimized}" Content="{DynamicResource General.StartMin}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Top}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="top" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Appearance.AlwaysOnTop}" Content="{DynamicResource Appearance.Topmost}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Close.Label}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,0,0,12" ToolTip="{DynamicResource Tip.Close}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="close" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding CloseBehaviors}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.General.CloseBehavior}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Profile.Name}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Profile}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveProfileCommand}" Margin="0,0,8,0" Content="{DynamicResource Profile.Save}" ToolTip="{DynamicResource Tip.Profile}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding DuplicateProfileCommand}" Margin="0,0,8,0" Content="{DynamicResource Profile.Duplicate}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding RenameProfileCommand}" Margin="0,0,8,0" Content="{DynamicResource Profile.Rename}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding DeleteProfileCommand}" Content="{DynamicResource Profile.Delete}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Settings.Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" MinHeight="72" ToolTip="{DynamicResource Tip.Profile}" />
                </StackPanel>

                <StackPanel x:Name="SectionHotkeys" Visibility="{Binding ShowHotkeys, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Hotkeys}" Style="{StaticResource TitleText}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Hotkey.Listening}" Style="{StaticResource HintText}" Visibility="{Binding CapturingHotkey, Converter={StaticResource NullToVis}}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding HotkeyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Hotkey}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Display}" />
                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding DataContext.CaptureHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding CaptureId}" Content="{DynamicResource Hotkey.Record}" />
                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding DataContext.ClearHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="{DynamicResource Hotkey.Clear}" />
                                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding DataContext.ResetHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="{DynamicResource Settings.Reset}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="SectionClicker" Visibility="{Binding ShowClicker, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Clicker}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Clicker.Button}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Button}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="button" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding ClickButtons}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Clicker.Button}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.Action}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Action}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="action" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding ClickActions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Clicker.Action}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Group.Timing}" Style="{StaticResource GroupLabel}" />
                    <TextBlock Text="{DynamicResource Label.Interval}" Style="{StaticResource FieldLabel}" />
                    <DockPanel x:Name="SetInterval" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Interval}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="interval" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Clicker.IntervalMs, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.JitterPercent}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Jitter}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="jitter" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Clicker.JitterPercent, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.HoldFor}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Hold}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="hold" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Clicker.HoldDurationMs, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.Repeat}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Repeat}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="repeat" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding RepeatModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Clicker.RepeatMode}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.Count}" Style="{StaticResource FieldLabel}" Visibility="{Binding Settings.Clicker.RepeatMode, Converter={StaticResource EnumVis}, ConverterParameter=Count}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Count}" Visibility="{Binding Settings.Clicker.RepeatMode, Converter={StaticResource EnumVis}, ConverterParameter=Count}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="count" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Clicker.RepeatCount, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.Duration}" Style="{StaticResource FieldLabel}" Visibility="{Binding Settings.Clicker.RepeatMode, Converter={StaticResource EnumVis}, ConverterParameter=Duration}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Duration}" Visibility="{Binding Settings.Clicker.RepeatMode, Converter={StaticResource EnumVis}, ConverterParameter=Duration}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="duration" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Clicker.DurationSeconds, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.Delay}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Delay}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="delay" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Clicker.StartDelayMs, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Precise}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="precise" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Clicker.PreciseTiming}" Content="{DynamicResource Clicker.Precise}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.Burst}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Burst}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="burst" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Clicker.BurstSize, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.BurstPause}" Style="{StaticResource FieldLabel}" />
                    <DockPanel x:Name="SetBurstPause" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.BurstPause}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="burst-pause" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Clicker.BurstPauseMs, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Group.Position}" Style="{StaticResource GroupLabel}" />
                    <TextBlock Text="{DynamicResource Clicker.Position}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Position}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="position" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding PositionModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Clicker.PositionMode}" /></DockPanel>
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding Settings.Clicker.PositionMode, Converter={StaticResource EnumVis}, ConverterParameter=Fixed}">
                        <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Fixed}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="fixed-x" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Clicker.FixedX, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                        <DockPanel ToolTip="{DynamicResource Tip.Fixed}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="fixed-y" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Clicker.FixedY, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding PickPositionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{DynamicResource Clicker.Pick}" ToolTip="{DynamicResource Tip.Pick}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Settings.Clicker.PositionMode, Converter={StaticResource EnumVis}, ConverterParameter=Sequence}">
                    <TextBlock Text="{DynamicResource Clicker.Sequence}" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{DynamicResource Clicker.SequenceHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding AddPointCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Content="{DynamicResource Clicker.AddPoint}" ToolTip="{DynamicResource Tip.Sequence}" />
                    <ListBox ItemsSource="{Binding Settings.Clicker.Points}" SelectedItem="{Binding SelectedPoint}" MinHeight="72" ToolTip="{DynamicResource Tip.Sequence}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock><Run Text="{Binding X, Mode=OneWay}" /><Run Text=", " /><Run Text="{Binding Y, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding DelayMs, Mode=OneWay}" /><Run Text=" ms" /></TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{DynamicResource Clicker.PointDelay}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding SelectedPoint.DelayMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.PointDelay}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.PointButton}">
                        <ComboBox Margin="8,0,0,0" ItemsSource="{Binding ClickButtons}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedPoint.Button}" />
                        <CheckBox IsChecked="{Binding SelectedPoint.CustomButton}" Content="{DynamicResource Clicker.CustomButton}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding MovePointCommand}" CommandParameter="up" Margin="0,0,8,0" Content="{DynamicResource Macro.Up}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding MovePointCommand}" CommandParameter="down" Margin="0,0,8,0" Content="{DynamicResource Macro.Down}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ResetPointCommand}" Margin="0,0,8,0" Content="{DynamicResource Settings.Reset}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding RemovePointCommand}" Content="{DynamicResource Profile.Delete}" />
                    </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Group.Safety}" Style="{StaticResource GroupLabel}" />
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Failsafe}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="failsafe" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.General.FailsafeEnabled}" Content="{DynamicResource General.Failsafe}" /></DockPanel>
                    <TextBlock Text="{DynamicResource General.Corner}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Corner}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="corner" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding Corners}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.General.FailsafeCorner}" /></DockPanel>
                    <TextBlock Text="{DynamicResource General.CornerSize}" Style="{StaticResource FieldLabel}" />
                    <DockPanel ToolTip="{DynamicResource Tip.CornerSize}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="corner-size" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.General.FailsafeSize, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                </StackPanel>

                <StackPanel x:Name="SectionJiggler" Visibility="{Binding ShowJiggler, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Jiggler}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Label.Mode}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.JMode}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="jiggler-mode" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding JigglerModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Jiggler.Mode}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Label.Interval}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.JInterval}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="jiggler-interval" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Jiggler.IntervalMs, Converter={StaticResource MsToSec}, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Jiggler.Jitter}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.JJitter}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="jiggler-jitter" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Jiggler.JitterMs, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Jiggler.Amplitude}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Amplitude}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="amplitude" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Jiggler.Amplitude, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Jiggler.Radius}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Radius}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="radius" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Jiggler.RadiusPx, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding PickRadiusCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Content="{DynamicResource Jiggler.PickRadius}" ToolTip="{DynamicResource Tip.Radius}" />
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Fullscreen}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="fullscreen" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Jiggler.PauseWhenFullscreen}" Content="{DynamicResource Jiggler.PauseFullscreen}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Center}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="fixed-center" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Jiggler.UseFixedCenter}" Content="{DynamicResource Jiggler.FixedCenter}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Presence.Motion}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Motion}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="presence-motion" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding Motions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Presence.Motion}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Presence.Interval}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.PInterval}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="presence-interval" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Presence.IntervalMs, Converter={StaticResource MsToSec}, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Presence.Jitter}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.PJitter}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="presence-jitter" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Presence.JitterMs, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Fallback}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="presence-fallback" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Presence.UseFallbackKey}" Content="{DynamicResource Presence.Fallback}" /></DockPanel>
                    <DockPanel Margin="0,8,0,8" ToolTip="{DynamicResource Tip.FallbackKey}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="presence-key" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding PresenceKeys}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Presence.FallbackKey}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Saver}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="presence-saver" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Presence.PreventScreensaver}" Content="{DynamicResource Presence.Screensaver}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Display}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="presence-display" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Presence.PreventDisplayOff}" Content="{DynamicResource Jiggler.PreventDisplay}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Sleep}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="presence-sleep" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Presence.PreventSleep}" Content="{DynamicResource Jiggler.PreventSleep}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Sleep}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="jiggler-sleep" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Jiggler.PreventSleep}" Content="{DynamicResource Jiggler.PreventSleep}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Display}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="jiggler-display" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Jiggler.PreventDisplayOff}" Content="{DynamicResource Jiggler.PreventDisplay}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.PauseInput}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="presence-pause" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Presence.PauseOnUserInput}" Content="{DynamicResource Jiggler.PauseInput}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Presence.Resume}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Resume}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="presence-resume" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Presence.ResumeIdleSeconds, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Jiggler.IdleSeconds}" Style="{StaticResource FieldLabel}" />
                    <DockPanel ToolTip="{DynamicResource Tip.Resume}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="jiggler-resume" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Jiggler.ResumeIdleSeconds, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                </StackPanel>

                <StackPanel x:Name="SectionSchedule" Visibility="{Binding ShowSchedule, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Schedule}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Work}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="work" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Work.Enabled}" Content="{DynamicResource Schedule.Enabled}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Schedule.Outside}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Outside}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="outside" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding OutsideBehaviors}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Work.Outside}" /></DockPanel>
                    <ItemsControl ItemsSource="{Binding Settings.Work.Days}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Window}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Schedule.AddWindow}" Command="{Binding DataContext.AddWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Day}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Windows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4,0,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Profile.Delete}" Command="{Binding DataContext.RemoveWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="{DynamicResource Settings.Reset}" Command="{Binding DataContext.ResetWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    <TextBox Width="80" Text="{Binding Start, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Start, Converter={StaticResource ClockValid}}" Value="False">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                    <TextBox Width="80" Text="{Binding End, UpdateSourceTrigger=LostFocus}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding End, Converter={StaticResource ClockValid}}" Value="False">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource Schedule.Holiday}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Holiday}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding AddHolidayCommand}" Content="{DynamicResource Schedule.AddHoliday}" /><DatePicker SelectedDate="{Binding HolidayDate}" /></DockPanel>
                    <ItemsControl ItemsSource="{Binding Settings.Work.Holidays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Profile.Delete}" Command="{Binding DataContext.RemoveHolidayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="SectionTyper" Visibility="{Binding ShowTyper, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Typer}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Typer.Speed}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Cpm}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="cpm" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Typer.CharactersPerMinute, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Typer.Jitter}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.TyperJitter}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="typer-jitter" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Typer.JitterPercent, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Typer.Punctuation}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Punct}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="punct" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Typer.PunctuationPauseMs, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Typos}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="typos" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.Typer.SimulateTypos}" Content="{DynamicResource Typer.Typos}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Typer.TypoPercent}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Typo}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="typo" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Typer.TypoPercent, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.Delay}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Delay}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="typer-delay" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Typer.StartDelayMs, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.Count}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Count}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="typer-count" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Typer.RepeatCount, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Typer.DateFormat}" Style="{StaticResource FieldLabel}" />
                    <DockPanel x:Name="SetDateFormat" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Date}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="date-format" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Typer.DateFormat, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Typer.TimeFormat}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Time}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="time-format" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Typer.TimeFormat, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Typer.DateTimeFormat}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.DateTime}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="datetime-format" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Typer.DateTimeFormat, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Typer.Text}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.TyperText}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="typer-text" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Typer.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" /></DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ImportClipboardCommand}" Margin="0,0,8,0" Content="{DynamicResource Typer.FromClipboard}" ToolTip="{DynamicResource Tip.Clipboard}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ImportTextFileCommand}" Content="{DynamicResource Typer.FromFile}" ToolTip="{DynamicResource Tip.TextFile}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Typer.SnippetName}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SnippetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Snippet}" />
                    <TextBlock Text="{DynamicResource Typer.SnippetText}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SnippetText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Snippet}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddSnippetCommand}" Margin="0,0,8,0" Content="{DynamicResource Typer.SaveSnippet}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ResetSnippetDraftCommand}" Content="{DynamicResource Settings.Reset}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Settings.Typer.Snippets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Profile.Delete}" Command="{Binding DataContext.DeleteSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="SectionMacro" Visibility="{Binding ShowMacro, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Macro}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Macro.Loop}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Loop}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="loop" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.Macro.LoopCount, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding InsertDelayCommand}" Margin="0,0,8,0" Content="{DynamicResource Macro.InsertDelay}" ToolTip="{DynamicResource Tip.Wait}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding MoveMacroCommand}" CommandParameter="up" Margin="0,0,8,0" Content="{DynamicResource Macro.Up}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding MoveMacroCommand}" CommandParameter="down" Margin="0,0,8,0" Content="{DynamicResource Macro.Down}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding DeleteMacroStepCommand}" Content="{DynamicResource Profile.Delete}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Settings.Macro.Events}" SelectedItem="{Binding SelectedMacro}" MinHeight="120" DisplayMemberPath="Kind" ToolTip="{DynamicResource Tip.Macro}" />
                    <TextBlock Text="{DynamicResource Macro.Delay}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Wait}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetMacroStepCommand}" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" />
                        <TextBox Text="{Binding SelectedMacro.DelayMs, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Macro.Kind}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SelectedMacro.Kind, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Macro}" />
                    <TextBlock Text="{DynamicResource Macro.Button}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SelectedMacro.Button, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding SaveMacroFileCommand}" Margin="0,0,8,0" Content="{DynamicResource Macro.Save}" ToolTip="{DynamicResource Tip.MacroFile}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding LoadMacroFileCommand}" Content="{DynamicResource Macro.Load}" ToolTip="{DynamicResource Tip.MacroFile}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SectionSystem" Visibility="{Binding ShowSystem, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.System}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Sound}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="sound" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.General.PlaySoundOnFinish}" Content="{DynamicResource General.Sound}" /></DockPanel>
                    <DockPanel Margin="0,8,0,8" ToolTip="{DynamicResource Tip.Sound}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="sound-name" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding Sounds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.General.SoundName}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Notify}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="notify-finish" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.General.NotifyOnFinish}" Content="{DynamicResource Notify.Finish}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Notify}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="notify-failsafe" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.General.NotifyOnFailsafe}" Content="{DynamicResource Notify.Failsafe}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Notify}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="notify-presence" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.General.NotifyOnPresence}" Content="{DynamicResource Notify.Presence}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Notify}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="notify-hotkey" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.General.NotifyOnHotkey}" Content="{DynamicResource Notify.Hotkey}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Log.Level}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Log}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="log" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" /><ComboBox ItemsSource="{Binding LogLevels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.General.LogLevel}" /></DockPanel>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Left" Content="{DynamicResource Log.Open}" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Log}" />
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Updates}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="updates" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.General.CheckForUpdates}" Content="{DynamicResource General.Updates}" /></DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ExportSettingsCommand}" Margin="0,0,8,0" Content="{DynamicResource Settings.Export}" ToolTip="{DynamicResource Tip.Export}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ImportSettingsCommand}" Content="{DynamicResource Settings.Import}" ToolTip="{DynamicResource Tip.Export}" />
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding UndoSettingsCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Content="{DynamicResource Settings.Undo}" ToolTip="{DynamicResource Tip.Undo}" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ResetAllCommand}" HorizontalAlignment="Left" Content="{DynamicResource Settings.ResetAll}" />
                </StackPanel>

                <StackPanel x:Name="SectionHealth" Visibility="{Binding ShowHealth, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Health}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Timer.After}" Style="{StaticResource FieldLabel}" />
                    <DockPanel x:Name="SetStopMinutes" Margin="0,0,0,8" ToolTip="{DynamicResource Tip.StopMinutes}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="stop-minutes" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.General.StopAfterMinutes, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Timer.Clock}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.StopTime}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="stop-time" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.General.StopAtTime, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.AutoProfile}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="auto-profile" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.General.AutoProfile}" Content="{DynamicResource Profile.Auto}" /></DockPanel>
                    <TextBlock Text="{DynamicResource Profile.Debounce}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,0,0,8" ToolTip="{DynamicResource Tip.Debounce}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="debounce" Content="{DynamicResource Settings.Reset}" /><TextBox Text="{Binding Settings.General.ProfileDebounceMs, UpdateSourceTrigger=LostFocus}" /></DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding AddRuleCommand}" Content="{DynamicResource Profile.AddRule}" />
                        <TextBox Width="140" Margin="0,0,8,0" Text="{Binding RuleProcess, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tip.Rule}" />
                        <TextBox Text="{Binding RuleProfile, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Tip.Rule}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Settings.General.AppRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.Rule}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Profile.Delete}" Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="{DynamicResource Settings.Reset}" Command="{Binding DataContext.ResetRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center"><Run Text="{Binding ProcessName, Mode=OneWay}" /><Run Text=" → " /><Run Text="{Binding ProfileName, Mode=OneWay}" /></TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource Stats.Title}" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding MainWindow.DataContext.WeekSummary, Source={x:Static Application.Current}}" TextWrapping="Wrap" Margin="0,4,0,8" ToolTip="{DynamicResource Tip.Stats}" />
                    <DockPanel Margin="0,2" ToolTip="{DynamicResource Tip.StatsOpt}"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="stats-opt" Content="{DynamicResource Settings.Reset}" /><CheckBox IsChecked="{Binding Settings.General.StatsOptOut}" Content="{DynamicResource Stats.OptOut}" /></DockPanel>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ResetStatsCommand}" HorizontalAlignment="Left" Margin="0,8,0,12" Content="{DynamicResource Stats.Reset}" ToolTip="{DynamicResource Tip.Stats}" />
                    <TextBlock Text="{DynamicResource Diagnosis.Title}" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{DynamicResource Diagnosis.Hint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunDiagnosisCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Content="{DynamicResource Diagnosis.Run}" ToolTip="{DynamicResource Tip.Diagnosis}" />
                    <TextBlock Text="{Binding DiagnosisText}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
