<Window x:Class="Takt.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}"
        Width="720" Height="680"
        MinWidth="640" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Settings.Title}" Style="{StaticResource TitleText}"
                   Margin="0,0,0,14" TextWrapping="Wrap" />
        <TabControl TabStripPlacement="Left" Padding="16,0,0,0">
            <TabItem Header="{DynamicResource Tab.Jiggler}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="{DynamicResource Label.Mode}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding JigglerModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Jiggler.Mode}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Label.Interval}" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.Jiggler.IntervalMs, Converter={StaticResource MsToSec}, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Label.Seconds}" Style="{StaticResource HintText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Jiggler.Amplitude}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.Jiggler.Amplitude, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Jiggler.Radius}" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.Jiggler.RadiusPx, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Column="1" Text="px" Style="{StaticResource HintText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Minimum="8" Maximum="800" SmallChange="1" LargeChange="16"
                                Value="{Binding Settings.Jiggler.RadiusPx, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,8" />
                        <TextBlock Text="{DynamicResource Jiggler.RadiusHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <CheckBox IsChecked="{Binding Settings.Jiggler.UseFixedCenter}" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Jiggler.FixedCenter}" TextWrapping="Wrap" />
                        </CheckBox>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.Jiggler.CenterX, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="2" Text="{Binding Settings.Jiggler.CenterY, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding PickRadiusCommand}"
                                HorizontalAlignment="Left" Margin="0,0,0,14" Padding="14,8">
                            <TextBlock Text="{DynamicResource Jiggler.PickRadius}" TextWrapping="Wrap" />
                        </Button>
                        <TextBlock Text="{DynamicResource Jiggler.Jitter}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.Jiggler.JitterMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                        <CheckBox IsChecked="{Binding Settings.Jiggler.PreventSleep}">
                            <TextBlock Text="{DynamicResource Jiggler.PreventSleep}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Settings.Jiggler.PreventDisplayOff}">
                            <TextBlock Text="{DynamicResource Jiggler.PreventDisplay}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Settings.Jiggler.WaitForIdle}">
                            <TextBlock Text="{DynamicResource Jiggler.WaitIdle}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{DynamicResource Jiggler.IdleSeconds}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Settings.Jiggler.IdleThresholdSeconds, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                        <CheckBox IsChecked="{Binding Settings.Jiggler.PauseOnUserInput}">
                            <TextBlock Text="{DynamicResource Jiggler.PauseInput}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Settings.Jiggler.PauseWhenFullscreen}">
                            <TextBlock Text="{DynamicResource Jiggler.PauseFullscreen}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Settings.Jiggler.UseSchedule}">
                            <TextBlock Text="{DynamicResource Jiggler.Schedule}" TextWrapping="Wrap" />
                        </CheckBox>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Jiggler.ScheduleStart}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Settings.Jiggler.ScheduleStart, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Jiggler.ScheduleEnd}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Settings.Jiggler.ScheduleEnd, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Clicker}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="{DynamicResource Clicker.Button}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ClickButtons}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Clicker.Button}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Clicker.Action}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding ClickActions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Clicker.Action}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Label.Interval}" Style="{StaticResource FieldLabel}" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.Clicker.IntervalMs, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Label.Milliseconds}" Style="{StaticResource HintText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Clicker.Jitter}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.Clicker.JitterMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Clicker.Burst}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.Clicker.BurstSize, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Clicker.BurstPause}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.Clicker.BurstPauseMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Clicker.Repeat}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding RepeatModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Clicker.RepeatMode}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Clicker.Count}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.Clicker.RepeatCount, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Clicker.Duration}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.Clicker.DurationSeconds, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Clicker.Delay}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.Clicker.StartDelayMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Clicker.Position}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding PositionModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Clicker.PositionMode}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Settings.Clicker.FixedX, UpdateSourceTrigger=LostFocus}" />
                            <TextBox Grid.Column="2" Text="{Binding Settings.Clicker.FixedY, UpdateSourceTrigger=LostFocus}" />
                            <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding PickPositionCommand}" Padding="12,8">
                                <TextBlock Text="{DynamicResource Clicker.Pick}" TextWrapping="Wrap" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Hotkeys}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Visibility="{Binding CapturingHotkey, Converter={StaticResource NullToVis}}"
                                   Style="{StaticResource HintText}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="{DynamicResource Hotkey.Listening}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" MinWidth="90" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource Hotkey.Jiggler}" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,6" />
                            <TextBlock Grid.Column="2" Text="{Binding JigglerHotkeyDisplay}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Style="{StaticResource GhostButton}" Command="{Binding CaptureHotkeyCommand}" CommandParameter="jiggler" Margin="0,4" Padding="10,6">
                                <TextBlock Text="{DynamicResource Hotkey.Record}" TextWrapping="NoWrap" />
                            </Button>

                            <TextBlock Grid.Row="1" Text="{DynamicResource Hotkey.Clicker}" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,6" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ClickerHotkeyDisplay}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource GhostButton}" Command="{Binding CaptureHotkeyCommand}" CommandParameter="clicker" Margin="0,4" Padding="10,6">
                                <TextBlock Text="{DynamicResource Hotkey.Record}" TextWrapping="NoWrap" />
                            </Button>

                            <TextBlock Grid.Row="2" Text="{DynamicResource Hotkey.Both}" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,6" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BothHotkeyDisplay}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource GhostButton}" Command="{Binding CaptureHotkeyCommand}" CommandParameter="both" Margin="0,4" Padding="10,6">
                                <TextBlock Text="{DynamicResource Hotkey.Record}" TextWrapping="NoWrap" />
                            </Button>

                            <TextBlock Grid.Row="3" Text="{DynamicResource Hotkey.Panic}" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,6" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding PanicHotkeyDisplay}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <Button Grid.Row="3" Grid.Column="4" Style="{StaticResource GhostButton}" Command="{Binding CaptureHotkeyCommand}" CommandParameter="panic" Margin="0,4" Padding="10,6">
                                <TextBlock Text="{DynamicResource Hotkey.Record}" TextWrapping="NoWrap" />
                            </Button>

                            <TextBlock Grid.Row="4" Text="{DynamicResource Hotkey.Pick}" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,6" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding PickHotkeyDisplay}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                            <Button Grid.Row="4" Grid.Column="4" Style="{StaticResource GhostButton}" Command="{Binding CaptureHotkeyCommand}" CommandParameter="pick" Margin="0,4" Padding="10,6">
                                <TextBlock Text="{DynamicResource Hotkey.Record}" TextWrapping="NoWrap" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Appearance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,8">
                        <TextBlock Text="{DynamicResource Appearance.Theme}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Appearance.Theme}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Appearance.Language}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Appearance.Language}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Appearance.Accent}" Style="{StaticResource FieldLabel}" />
                        <ItemsControl ItemsSource="{Binding AccentPresets}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="28" Height="28" Margin="0,0,8,8"
                                            Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6" Background="{Binding Converter={StaticResource HexToBrush}}" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding Settings.Appearance.AccentHex, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12" />
                        <CheckBox IsChecked="{Binding Settings.Appearance.AlwaysOnTop}">
                            <TextBlock Text="{DynamicResource Appearance.Topmost}" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,8">
                        <CheckBox IsChecked="{Binding Settings.General.MinimizeToTray}">
                            <TextBlock Text="{DynamicResource General.Tray}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Settings.General.StartMinimized}">
                            <TextBlock Text="{DynamicResource General.StartMin}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Settings.General.StartWithWindows}">
                            <TextBlock Text="{DynamicResource General.Autostart}" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox IsChecked="{Binding Settings.General.FailsafeEnabled}">
                            <TextBlock Text="{DynamicResource General.Failsafe}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{DynamicResource General.Corner}" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                        <ComboBox ItemsSource="{Binding Corners}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.General.FailsafeCorner}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource General.CornerSize}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Settings.General.FailsafeSize, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource General.FailsafeHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
