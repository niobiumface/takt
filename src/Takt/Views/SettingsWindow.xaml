<Window x:Class="Takt.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}"
        Width="920" Height="680"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <TextBox DockPanel.Dock="Top" Margin="0,0,0,8"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{DynamicResource Settings.Search}" />
            <ListBox ItemsSource="{Binding Navigation}"
                     SelectedValuePath="Id"
                     SelectedValue="{Binding SelectedSection}"
                     DisplayMemberPath="Title"
                     BorderThickness="0"
                     Background="Transparent" />
        </DockPanel>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4,0,8,12">
                <StackPanel Visibility="{Binding ShowGeneral, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.General}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Appearance.Theme}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="theme" Margin="8,0,0,0" Content="{DynamicResource Settings.Reset}" />
                        <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Appearance.Theme}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Appearance.Language}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Appearance.Language}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Appearance.Accent}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Appearance.AccentHex, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding Settings.General.StartWithWindows}" Content="{DynamicResource General.Autostart}" />
                    <CheckBox IsChecked="{Binding Settings.General.StartMinimized}" Content="{DynamicResource General.StartMin}" />
                    <CheckBox IsChecked="{Binding Settings.Appearance.AlwaysOnTop}" Content="{DynamicResource Appearance.Topmost}" />
                    <TextBlock Text="{DynamicResource Close.Label}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding CloseBehaviors}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.General.CloseBehavior}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Profile.Name}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveProfileCommand}" Margin="0,0,8,0" Content="{DynamicResource Profile.Save}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding DuplicateProfileCommand}" Margin="0,0,8,0" Content="{DynamicResource Profile.Duplicate}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding RenameProfileCommand}" Margin="0,0,8,0" Content="{DynamicResource Profile.Rename}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding DeleteProfileCommand}" Content="{DynamicResource Profile.Delete}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Settings.Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" MinHeight="72" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowHotkeys, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Hotkeys}" Style="{StaticResource TitleText}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Hotkey.Listening}" Style="{StaticResource HintText}"
                               Visibility="{Binding CapturingHotkey, Converter={StaticResource NullToVis}}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding HotkeyRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Display}" />
                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.CaptureHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding CaptureId}" Content="{DynamicResource Hotkey.Record}" />
                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ClearHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Content="{DynamicResource Hotkey.Clear}" />
                                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ResetHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Content="{DynamicResource Settings.Reset}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowClicker, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Clicker}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Clicker.Button}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ClickButtons}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Clicker.Button}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Clicker.Action}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ClickActions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Clicker.Action}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Label.Interval}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="interval" Content="{DynamicResource Settings.Reset}" />
                        <TextBox Text="{Binding Settings.Clicker.IntervalMs, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Clicker.JitterPercent}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Clicker.JitterPercent, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Clicker.HoldFor}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Clicker.HoldDurationMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Clicker.Repeat}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding RepeatModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Clicker.RepeatMode}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Clicker.Count}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Clicker.RepeatCount, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Clicker.Delay}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Clicker.StartDelayMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding Settings.Clicker.PreciseTiming}" Content="{DynamicResource Clicker.Precise}" />
                    <TextBlock Text="{DynamicResource Clicker.Burst}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Settings.Clicker.BurstSize, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Clicker.Position}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding PositionModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Clicker.PositionMode}" Margin="0,0,0,8" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding PickPositionCommand}" HorizontalAlignment="Left" Content="{DynamicResource Clicker.Pick}" />
                    <CheckBox IsChecked="{Binding Settings.General.FailsafeEnabled}" Content="{DynamicResource General.Failsafe}" />
                    <TextBlock Text="{DynamicResource General.Corner}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding Corners}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.General.FailsafeCorner}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource General.CornerSize}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.General.FailsafeSize, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowJiggler, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Jiggler}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Label.Mode}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding JigglerModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Jiggler.Mode}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Label.Interval}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Jiggler.IntervalMs, Converter={StaticResource MsToSec}, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Jiggler.Jitter}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Jiggler.JitterMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Jiggler.Amplitude}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Jiggler.Amplitude, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Jiggler.Radius}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Jiggler.RadiusPx, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding PickRadiusCommand}" HorizontalAlignment="Left" Margin="0,0,0,8" Content="{DynamicResource Jiggler.PickRadius}" />
                    <CheckBox IsChecked="{Binding Settings.Jiggler.PauseWhenFullscreen}" Content="{DynamicResource Jiggler.PauseFullscreen}" />
                    <CheckBox IsChecked="{Binding Settings.Jiggler.UseFixedCenter}" Content="{DynamicResource Jiggler.FixedCenter}" />
                    <TextBlock Text="{DynamicResource Presence.Motion}" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Motions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Presence.Motion}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Presence.Interval}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ResetSettingCommand}" CommandParameter="presence-interval" Content="{DynamicResource Settings.Reset}" />
                        <TextBox Text="{Binding Settings.Presence.IntervalMs, Converter={StaticResource MsToSec}, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource Presence.Jitter}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Presence.JitterMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding Settings.Presence.UseFallbackKey}" Content="{DynamicResource Presence.Fallback}" />
                    <ComboBox ItemsSource="{Binding PresenceKeys}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Presence.FallbackKey}" Margin="0,8,0,8" />
                    <CheckBox IsChecked="{Binding Settings.Presence.PreventScreensaver}" Content="{DynamicResource Presence.Screensaver}" />
                    <CheckBox IsChecked="{Binding Settings.Presence.PreventDisplayOff}" Content="{DynamicResource Jiggler.PreventDisplay}" />
                    <CheckBox IsChecked="{Binding Settings.Presence.PreventSleep}" Content="{DynamicResource Jiggler.PreventSleep}" />
                    <CheckBox IsChecked="{Binding Settings.Jiggler.PreventSleep}" Content="{DynamicResource Jiggler.PreventSleep}" />
                    <CheckBox IsChecked="{Binding Settings.Jiggler.PreventDisplayOff}" Content="{DynamicResource Jiggler.PreventDisplay}" />
                    <CheckBox IsChecked="{Binding Settings.Presence.PauseOnUserInput}" Content="{DynamicResource Jiggler.PauseInput}" />
                    <TextBlock Text="{DynamicResource Presence.Resume}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Settings.Presence.ResumeIdleSeconds, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Jiggler.IdleSeconds}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Jiggler.ResumeIdleSeconds, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowSchedule, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Schedule}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <CheckBox IsChecked="{Binding Settings.Work.Enabled}" Content="{DynamicResource Schedule.Enabled}" />
                    <TextBlock Text="{DynamicResource Schedule.Outside}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding OutsideBehaviors}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Work.Outside}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Settings.Work.Days}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Schedule.AddWindow}"
                                                Command="{Binding DataContext.AddWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Day}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Windows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4,0,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Profile.Delete}"
                                                            Command="{Binding DataContext.RemoveWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBox Width="80" Text="{Binding Start, UpdateSourceTrigger=LostFocus}" Margin="0,0,8,0" />
                                                    <TextBox Width="80" Text="{Binding End, UpdateSourceTrigger=LostFocus}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource Schedule.Holiday}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding AddHolidayCommand}" Content="{DynamicResource Schedule.AddHoliday}" />
                        <DatePicker SelectedDate="{Binding HolidayDate}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Settings.Work.Holidays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Profile.Delete}"
                                            Command="{Binding DataContext.RemoveHolidayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowTyper, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.Typer}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Typer.Speed}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Typer.CharactersPerMinute, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Typer.Jitter}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Typer.JitterPercent, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Typer.Punctuation}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Typer.PunctuationPauseMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding Settings.Typer.SimulateTypos}" Content="{DynamicResource Typer.Typos}" />
                    <TextBlock Text="{DynamicResource Typer.TypoPercent}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding Settings.Typer.TypoPercent, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Clicker.Delay}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Typer.StartDelayMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Clicker.Count}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Typer.RepeatCount, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Typer.Text}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Settings.Typer.Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Typer.SnippetName}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SnippetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource Typer.SnippetText}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SnippetText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="48" Margin="0,0,0,8" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddSnippetCommand}" HorizontalAlignment="Left" Content="{DynamicResource Typer.SaveSnippet}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Settings.Typer.Snippets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{DynamicResource Profile.Delete}"
                                            Command="{Binding DataContext.DeleteSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowSystem, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{DynamicResource Nav.System}" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                    <CheckBox IsChecked="{Binding Settings.General.PlaySoundOnFinish}" Content="{DynamicResource General.Sound}" />
                    <ComboBox ItemsSource="{Binding Sounds}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.General.SoundName}" Margin="0,8,0,8" />
                    <CheckBox IsChecked="{Binding Settings.General.NotifyOnFinish}" Content="{DynamicResource Notify.Finish}" />
                    <CheckBox IsChecked="{Binding Settings.General.NotifyOnFailsafe}" Content="{DynamicResource Notify.Failsafe}" />
                    <CheckBox IsChecked="{Binding Settings.General.NotifyOnPresence}" Content="{DynamicResource Notify.Presence}" />
                    <CheckBox IsChecked="{Binding Settings.General.NotifyOnHotkey}" Content="{DynamicResource Notify.Hotkey}" />
                    <TextBlock Text="{DynamicResource Log.Level}" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding LogLevels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.General.LogLevel}" Margin="0,0,0,8" />
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Left" Content="{DynamicResource Log.Open}" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding Settings.General.CheckForUpdates}" Content="{DynamicResource General.Updates}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ExportSettingsCommand}" Margin="0,0,8,0" Content="{DynamicResource Settings.Export}" />
                        <Button Style="{StaticResource GhostButton}" Command="{Binding ImportSettingsCommand}" Content="{DynamicResource Settings.Import}" />
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ResetAllCommand}" HorizontalAlignment="Left" Content="{DynamicResource Settings.ResetAll}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
