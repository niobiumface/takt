<Window x:Class="Takt.Views.RadiusPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#66000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        ResizeMode="NoResize"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnClick"
        MouseMove="OnMove">
    <Grid>
        <Canvas x:Name="DrawCanvas" IsHitTestVisible="False">
            <Ellipse x:Name="RadiusEllipse"
                     Stroke="White"
                     StrokeThickness="2"
                     StrokeDashArray="4 3"
                     Fill="#22FFFFFF"
                     Visibility="Collapsed" />
            <Ellipse x:Name="CenterDot"
                     Width="8" Height="8"
                     Fill="White"
                     Visibility="Collapsed" />
        </Canvas>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock x:Name="HintLabel"
                       Foreground="White"
                       FontSize="18"
                       FontFamily="Segoe UI"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="520" />
            <TextBlock x:Name="MeasureLabel"
                       Foreground="White"
                       FontSize="14"
                       Margin="0,12,0,0"
                       TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
