<Window x:Class="Takt.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Wizard.Title}"
        Width="460" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Click="OnSkip" Content="{DynamicResource Wizard.Skip}" ToolTip="{DynamicResource Tip.WizardSkip}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Click="OnBack" Margin="0,0,8,0" Content="{DynamicResource Wizard.Back}" />
                <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Click="OnNext" Content="{DynamicResource Wizard.Next}" />
            </StackPanel>
        </DockPanel>
        <StackPanel x:Name="StepHotkeys">
            <TextBlock Text="{DynamicResource Wizard.HotkeysTitle}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{DynamicResource Wizard.HotkeysBody}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,8" />
            <TextBlock Text="{Binding PanicHotkeyText}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel x:Name="StepHours" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Wizard.HoursTitle}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{DynamicResource Wizard.HoursBody}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,8" />
            <CheckBox IsChecked="{Binding Settings.Work.Enabled}" Content="{DynamicResource Schedule.Enabled}" ToolTip="{DynamicResource Tip.Work}" />
        </StackPanel>
        <StackPanel x:Name="StepPresence" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Wizard.PresenceTitle}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{DynamicResource Wizard.PresenceBody}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,8" />
            <CheckBox IsChecked="{Binding Settings.Presence.Enabled}" Content="{DynamicResource Presence.Toggle}" ToolTip="{DynamicResource Tip.Presence}" />
        </StackPanel>
    </DockPanel>
</Window>
