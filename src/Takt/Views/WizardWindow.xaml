<Window x:Class="Takt.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Wizard.Title}"
        Width="520" Height="560"
        PreviewKeyDown="OnPreviewKeyDown"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Click="OnSkip" Content="{DynamicResource Wizard.Skip}" ToolTip="{DynamicResource Tip.WizardSkip}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Click="OnBack" Margin="0,0,8,0" Content="{DynamicResource Wizard.Back}" />
                <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Click="OnNext" Content="{DynamicResource Wizard.Next}" />
            </StackPanel>
        </DockPanel>
        <StackPanel x:Name="StepHotkeys">
            <TextBlock Text="{DynamicResource Wizard.HotkeysTitle}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{DynamicResource Wizard.HotkeysBody}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,4" />
            <TextBlock Text="{DynamicResource Wizard.HotkeyEdit}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{DynamicResource Hotkey.Listening}" Style="{StaticResource HintText}" Visibility="{Binding CapturingHotkey, Converter={StaticResource NullToVis}}" Margin="0,0,0,8" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                <ItemsControl ItemsSource="{Binding HotkeyRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{Binding Display}" Style="{StaticResource HintText}" />
                                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.CaptureHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding CaptureId}" Content="{DynamicResource Hotkey.Record}" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.ResetHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Content="{DynamicResource Settings.Reset}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <StackPanel x:Name="StepHours" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Wizard.HoursTitle}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{DynamicResource Wizard.HoursBody}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,8" />
            <CheckBox IsChecked="{Binding Settings.Work.Enabled}" Content="{DynamicResource Schedule.Enabled}" ToolTip="{DynamicResource Tip.Work}" />
        </StackPanel>
        <StackPanel x:Name="StepPresence" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Wizard.PresenceTitle}" Style="{StaticResource TitleText}" />
            <TextBlock Text="{DynamicResource Wizard.PresenceBody}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,8" />
            <CheckBox IsChecked="{Binding Settings.Presence.Enabled}" Content="{DynamicResource Presence.Toggle}" ToolTip="{DynamicResource Tip.Presence}" />
        </StackPanel>
    </DockPanel>
</Window>
